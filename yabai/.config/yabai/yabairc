#!/usr/bin/env zsh

# Layout: manual BSP, closest to i3's default behavior
yabai -m config layout stack
yabai -m config auto_balance off

# Gaps and padding
yabai -m config top_padding 1
yabai -m config bottom_padding 1
yabai -m config left_padding 1
yabai -m config right_padding 1
yabai -m config window_gap 1

# Mouse: hold ctrl and drag to move/resize
yabai -m config mouse_modifier ctrl
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

# Focus behavior
yabai -m config focus_follows_mouse off
yabai -m config window_placement second_child

# Keep macOS-native windows usable
yabai -m rule --add app='^System Settings$' manage=off
yabai -m rule --add app='^System Information$' manage=off
yabai -m rule --add app='^Calculator$' manage=off
yabai -m rule --add app='^Preview$' manage=off
yabai -m rule --add title='^Settings$' manage=off

# Label spaces 1-9 so skhd can address them reliably
for i in $(seq 1 9); do
  yabai -m space "$i" --label "$i"
done
