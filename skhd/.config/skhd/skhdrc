# Terminal: Alt+Enter
alt - return : open -na Ghostty.app --args

# Close focused window: Alt+Shift+Q
alt + shift - q : yabai -m window --close

# Focus: Alt+h/j/k/l
alt - h : yabai -m window --focus west || yabai -m display --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east || yabai -m display --focus east

# Move/swap window: Alt+Shift+h/j/k/l
alt + shift - h : yabai -m window --warp west || yabai -m window --display west
alt + shift - j : yabai -m window --warp south
alt + shift - k : yabai -m window --warp north
alt + shift - l : yabai -m window --warp east || yabai -m window --display east

# Resize: Alt+Ctrl+h/j/k/l
alt + ctrl - h : yabai -m window --resize left:-60:0
alt + ctrl - j : yabai -m window --resize bottom:0:60
alt + ctrl - k : yabai -m window --resize top:0:-60
alt + ctrl - l : yabai -m window --resize right:60:0

# Equalize current workspace
alt - e : yabai -m space --balance

# Rotate layout: Alt+r
alt - r : yabai -m space --rotate 90

# Toggle split orientation for the focused window
alt - v : yabai -m window --toggle split

# Toggle fullscreen-like zoom: Alt+f
alt - f : yabai -m window --toggle zoom-fullscreen

# Float / unfloat: Alt+Shift+Space
alt + shift - space : yabai -m window --toggle float

# Workspaces: Alt+1..9
alt - 1 : yabai -m space --focus 1 || yabai -m space --focus recent
alt - 2 : yabai -m space --focus 2 || yabai -m space --focus recent
alt - 3 : yabai -m space --focus 3 || yabai -m space --focus recent
alt - 4 : yabai -m space --focus 4 || yabai -m space --focus recent
alt - 5 : yabai -m space --focus 5 || yabai -m space --focus recent
alt - 6 : yabai -m space --focus 6 || yabai -m space --focus recent
alt - 7 : yabai -m space --focus 7 || yabai -m space --focus recent
alt - 8 : yabai -m space --focus 8 || yabai -m space --focus recent
alt - 9 : yabai -m space --focus 9 || yabai -m space --focus recent

# Send window to workspace: Alt+Shift+1..9
alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5
alt + shift - 6 : yabai -m window --space 6
alt + shift - 7 : yabai -m window --space 7
alt + shift - 8 : yabai -m window --space 8
alt + shift - 9 : yabai -m window --space 9


# Restart services
alt + ctrl - r : yabai --restart-service && skhd --restart-service

# Gaps: Alt+g toggles gaps/padding, Alt+= / Alt+- grow/shrink gaps and padding
alt - g    : yabai -m space --toggle gap; yabai -m space --toggle padding
alt - 0x18 : yabai -m space --gap rel:2 --padding rel:2:2:2:2
alt - 0x1B : yabai -m space --gap rel:-2 --padding rel:-2:-2:-2:-2

# Stacking: Alt+s toggles current space between tiled and stacked
alt - s : yabai -m space --layout $(yabai -m query --spaces --space | jq -r 'if .type == "bsp" then "stack" else "bsp" end')

# Cycle through stacked windows: Alt+n / Alt+p (wraps around)
alt - n : yabai -m window --focus stack.next || yabai -m window --focus stack.first
alt - p : yabai -m window --focus stack.prev || yabai -m window --focus stack.last
