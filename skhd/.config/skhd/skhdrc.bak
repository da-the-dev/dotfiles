# Terminal: Cmd+Enter
cmd - return : open -na Ghostty.app --args

# Close focused window: Cmd+Shift+Q
cmd + shift - q : yabai -m window --close

# Focus: Cmd+h/j/k/l
cmd - h : yabai -m window --focus west || yabai -m display --focus west
cmd - j : yabai -m window --focus south
cmd - k : yabai -m window --focus north
cmd - l : yabai -m window --focus east || yabai -m display --focus east

# Move/swap window: Cmd+Shift+h/j/k/l
cmd + shift - h : yabai -m window --warp west || yabai -m window --display west
cmd + shift - j : yabai -m window --warp south
cmd + shift - k : yabai -m window --warp north
cmd + shift - l : yabai -m window --warp east || yabai -m window --display east

# Resize: Cmd+Ctrl+h/j/k/l
cmd + ctrl - h : yabai -m window --resize left:-60:0
cmd + ctrl - j : yabai -m window --resize bottom:0:60
cmd + ctrl - k : yabai -m window --resize top:0:-60
cmd + ctrl - l : yabai -m window --resize right:60:0

# Equalize current workspace
cmd - e : yabai -m space --balance

# Rotate layout: Cmd+r
cmd - r : yabai -m space --rotate 90

# Toggle split orientation for the focused window
cmd - v : yabai -m window --toggle split

# Toggle fullscreen-like zoom: Cmd+f
cmd - f : yabai -m window --toggle zoom-fullscreen

# Float / unfloat: Cmd+Shift+Space
cmd + shift - space : yabai -m window --toggle float

# Workspaces: Cmd+1..9
cmd - 1 : yabai -m space --focus 1 || yabai -m space --focus recent
cmd - 2 : yabai -m space --focus 2 || yabai -m space --focus recent
cmd - 3 : yabai -m space --focus 3 || yabai -m space --focus recent
cmd - 4 : yabai -m space --focus 4 || yabai -m space --focus recent
cmd - 5 : yabai -m space --focus 5 || yabai -m space --focus recent
cmd - 6 : yabai -m space --focus 6 || yabai -m space --focus recent
cmd - 7 : yabai -m space --focus 7 || yabai -m space --focus recent
cmd - 8 : yabai -m space --focus 8 || yabai -m space --focus recent
cmd - 9 : yabai -m space --focus 9 || yabai -m space --focus recent

# Send window to workspace: Cmd+Shift+1..9
cmd + shift - 1 : yabai -m window --space 1
cmd + shift - 2 : yabai -m window --space 2
cmd + shift - 3 : yabai -m window --space 3
cmd + shift - 4 : yabai -m window --space 4
cmd + shift - 5 : yabai -m window --space 5
cmd + shift - 6 : yabai -m window --space 6
cmd + shift - 7 : yabai -m window --space 7
cmd + shift - 8 : yabai -m window --space 8
cmd + shift - 9 : yabai -m window --space 9

# Move window to next/prev workspace: Cmd+Shift+Right/Left
cmd + shift - right : yabai -m window --space next
cmd + shift - left : yabai -m window --space prev

# Restart services
cmd + ctrl - r : yabai --restart-service && skhd --restart-service
